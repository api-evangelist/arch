{
  "opencollection": "1.0.0",
  "info": {
    "name": "Arch Client Accounts Firms API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Firms",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a paginated list of firms",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/client-api/v0/firms",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The number of firms to return per page"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The number of firms to skip before collecting results"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a paginated list of firms that the authenticated user has access to."
        },
        {
          "info": {
            "name": "Get a firm by ID.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/client-api/v0/firms/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the firm to get."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a firm by ID."
        }
      ]
    }
  ],
  "bundled": true
}